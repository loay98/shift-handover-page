@model ShiftLogInputModel
@{
    ViewData["Title"] = "Add log entry";
}

<div class="surface-panel form-panel">
    <div class="section-heading">
        <div>
            <p class="eyebrow">Shift logging</p>
            <h1>Add a log entry</h1>
        </div>
    </div>

    <form asp-action="Log" method="post" class="shift-form">
        @Html.AntiForgeryToken()
        <input asp-for="ShiftId" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="LogType" class="form-label"></label>
                <select asp-for="LogType" class="form-select" asp-items="Html.GetEnumSelectList<ShiftLogType>()"></select>
                <span asp-validation-for="LogType" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="OccurredAt" class="form-label"></label>
                <input asp-for="OccurredAt" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />
                <span asp-validation-for="OccurredAt" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="ManpowerCount" class="form-label"></label>
                <input asp-for="ManpowerCount" class="form-control" />
                <span asp-validation-for="ManpowerCount" class="text-danger"></span>
            </div>
        </div>

        <div class="card-actions mt-4">
            <a class="btn btn-outline-light" asp-action="Details" asp-route-id="@Model.ShiftId">Cancel</a>
            <button class="btn btn-primary" type="submit">Save log</button>
        </div>
    </form>
</div>